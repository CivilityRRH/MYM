{
  "entities": {
    "JobRequirement": {
      "title": "Job Requirement",
      "description": "Screening criteria and custom questions for candidate positions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "roleName": { "type": "string" },
        "ageRange": { "type": "string" },
        "minExperienceYears": { "type": "number" },
        "uniqueExceptionsCriteria": { "type": "string" },
        "radiusMiles": { "type": "number" },
        "offerRelocationCost": { "type": "boolean" },
        "relocationBudgetAmount": { "type": "number" },
        "locationCity": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "roleName", "status"]
    },
    "CandidateProfile": {
      "title": "Candidate Profile",
      "description": "Candidate applicant record with submission and evaluation data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "locationCity": { "type": "string" },
        "age": { "type": "number" },
        "experienceYears": { "type": "number" },
        "currentCompany": { "type": "string" },
        "currentRole": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "fullName", "email", "status"]
    },
    "GoogleFormItem": {
      "title": "Google Form Item",
      "description": "Synced Google Form associated with screening requirements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "formId": { "type": "string" },
        "title": { "type": "string" },
        "responderUri": { "type": "string" },
        "jobId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "formId", "title"]
    },
    "GoogleTaskItem": {
      "title": "Google Task Item",
      "description": "Synced Google Task item for hiring workflow",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "title": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "candidateId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "taskId", "title"]
    },
    "LinkedInAuthAccount": {
      "title": "LinkedIn Auth Account",
      "description": "Connected LinkedIn Recruiter OAuth Account credentials and sync status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "connected": { "type": "boolean" },
        "linkedInName": { "type": "string" },
        "linkedInEmail": { "type": "string" },
        "linkedInHeadline": { "type": "string" },
        "linkedInProfileUrl": { "type": "string" },
        "recruiterSeatActive": { "type": "boolean" },
        "openToWorkNetworkEnabled": { "type": "boolean" },
        "connectedAt": { "type": "string" }
      },
      "required": ["connected", "linkedInName"]
    },
    "LinkedInScoutQuery": {
      "title": "LinkedIn Scout Query",
      "description": "Saved LinkedIn candidate scout search query log in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "roleQuery": { "type": "string" },
        "locationQuery": { "type": "string" },
        "filterMode": { "type": "string" },
        "linkedInVerifiedOnly": { "type": "boolean" },
        "resultsCount": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "roleQuery"]
    },
    "EmployeeJourney": {
      "title": "Employee Journey",
      "description": "Employee continuous civility scores, refresher modules, and scorecard records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeName": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "certificationLevel": { "type": "string" },
        "overallCurrentScore": { "type": "number" },
        "hireDate": { "type": "string" },
        "lastAssessedAt": { "type": "string" }
      },
      "required": ["id", "employeeName", "role"]
    },
    "RecentHireFeedItem": {
      "title": "Recent Hire Feed Item",
      "description": "Live social feed post for recent verified candidate hires",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "candidateName": { "type": "string" },
        "candidateRole": { "type": "string" },
        "hiredForJobTitle": { "type": "string" },
        "civilityScore": { "type": "number" },
        "announcementText": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "candidateName", "candidateRole"]
    },
    "TrainingSession": {
      "title": "Training Session",
      "description": "Recorded training or assessment session with score and feedback",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "candidateName": { "type": "string" },
        "scenarioTitle": { "type": "string" },
        "score": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "scenarioTitle"]
    },
    "CrisisScenario": {
      "title": "Crisis Scenario",
      "description": "Custom or standard high-pressure crisis scenario",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "prompt": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "CompanyJobAd": {
      "title": "Company Job Ad",
      "description": "Company free job advertisement posting with commission terms",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "companyName": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "title", "companyName"]
    },
    "AdApplication": {
      "title": "Ad Application",
      "description": "Candidate application to a company job ad",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "adId": { "type": "string" },
        "candidateName": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "adId", "candidateName"]
    },
    "CommissionInvoice": {
      "title": "Commission Invoice",
      "description": "Commission billing invoice record upon verified hire",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "companyName", "amount"]
    }
  },
  "firestore": {
    "/job_requirements/{jobId}": {
      "schema": { "$ref": "#/entities/JobRequirement" },
      "description": "Collection of active and archived job requirements"
    },
    "/candidates/{candidateId}": {
      "schema": { "$ref": "#/entities/CandidateProfile" },
      "description": "Collection of candidate profiles and evaluations"
    },
    "/training_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/TrainingSession" },
      "description": "Collection of candidate training and assessment runs"
    },
    "/crisis_scenarios/{scenarioId}": {
      "schema": { "$ref": "#/entities/CrisisScenario" },
      "description": "Collection of emergency crisis scenarios"
    },
    "/google_forms/{formRecordId}": {
      "schema": { "$ref": "#/entities/GoogleFormItem" },
      "description": "Collection of Google Forms created for positions"
    },
    "/google_tasks/{taskRecordId}": {
      "schema": { "$ref": "#/entities/GoogleTaskItem" },
      "description": "Collection of Google Tasks created for recruiting follow-ups"
    },
    "/linkedin_scouts/{scoutId}": {
      "schema": { "$ref": "#/entities/LinkedInAuthAccount" },
      "description": "Collection of connected LinkedIn Recruiter Auth accounts"
    },
    "/linkedin_scout_queries/{queryId}": {
      "schema": { "$ref": "#/entities/LinkedInScoutQuery" },
      "description": "Collection of recorded LinkedIn scout searches in Firebase"
    },
    "/employee_journeys/{journeyId}": {
      "schema": { "$ref": "#/entities/EmployeeJourney" },
      "description": "Collection of staff member employee journeys and scorecards"
    },
    "/recent_hires/{feedItemId}": {
      "schema": { "$ref": "#/entities/RecentHireFeedItem" },
      "description": "Collection of recent hire feed items"
    },
    "/recent_hires_feed/{feedItemId}": {
      "schema": { "$ref": "#/entities/RecentHireFeedItem" },
      "description": "Collection of recent hire feed items alias"
    },
    "/company_job_ads/{adId}": {
      "schema": { "$ref": "#/entities/CompanyJobAd" },
      "description": "Collection of free company job postings"
    },
    "/ad_applications/{appId}": {
      "schema": { "$ref": "#/entities/AdApplication" },
      "description": "Collection of ad candidate submissions"
    },
    "/commission_invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/CommissionInvoice" },
      "description": "Collection of 12% placement commission invoices"
    }
  }
}
